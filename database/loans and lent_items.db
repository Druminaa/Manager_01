-- Table for money you've borrowed
create table loans (
  id bigint generated by default as identity primary key,
  user_id uuid references auth.users on delete cascade not null,
  lender_name text not null,
  principal numeric(10, 2) not null,
  apr numeric(5, 2) not null,
  term integer not null, -- in years
  monthly_payment numeric(10, 2) not null,
  next_payment_date date not null,
  remaining_balance numeric(10, 2) not null,
  created_at timestamp with time zone default timezone('utc'::text, now()) not null
);

-- Table for money you've lent
create table lent_items (
  id bigint generated by default as identity primary key,
  user_id uuid references auth.users on delete cascade not null,
  borrower_name text not null,
  amount numeric(10, 2) not null,
  due_date date,
  notes text,
  status text check (status in ('active', 'paid')) not null,
  created_at timestamp with time zone default timezone('utc'::text, now()) not null
);

-- Set up RLS for both tables
alter table loans enable row level security;
create policy "Users can manage their own loans." on loans for all using (auth.uid() = user_id);

alter table lent_items enable row level security;
create policy "Users can manage their own lent items." on lent_items for all using (auth.uid() = user_id);

